    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-vue": "^10.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.0",
    "vite": "^7.0.0"
  },
  "license": "MIT",
  "allowScripts": {
    "esbuild@0.28.2": true
