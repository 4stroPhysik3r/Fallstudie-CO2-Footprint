{
  "name": "co2-footprint-vue",
  "version": "2.0.1",
  "description": "Öffentliche Webseite zur Transparenz von CO2-Emissionen (Länder und Unternehmen) – Vue 3 + Vite + Tailwind CSS",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
